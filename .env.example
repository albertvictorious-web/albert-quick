# Contoh environment variables. JANGAN commit file .env yang berisi nilai asli.
#
# Di Vercel, ketiga variabel ini diisi lewat:
#   Project -> Settings -> Environment Variables (centang Production + Preview)

# Connection string MongoDB Atlas.
# Ambil dari Atlas -> Cluster -> Connect -> Drivers -> Python.
# Karakter khusus pada username/password WAJIB di-URL-encode (@ -> %40, dst).
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# Nama database di dalam cluster. Dibuat otomatis saat data pertama masuk.
DB_NAME="quickpro_crm"

# Kunci penanda-tangan JWT sesi login. WAJIB diganti untuk produksi.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kalau kunci ini diganti, semua sesi login yang sedang aktif jadi tidak valid.
SECRET_KEY="ganti-dengan-hasil-generate-minimal-32-karakter"

# Opsional. Aplikasi satu origin (frontend + /api sedomain) jadi CORS tidak dipakai.
CORS_ORIGINS="*"

# Opsional. Kosongkan saja: cookie otomatis Secure di Vercel dan non-Secure di
# localhost. Isi "true"/"false" hanya kalau mau memaksa.
# COOKIE_SECURE=""
